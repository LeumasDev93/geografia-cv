# Base de dados com a tabela `geografia` (ex.: Neon). Vazio: usa os dados incluídos no pacote.
DATABASE_URL=
# Porta do servidor autónomo e prefixo das rotas.
PORT=4100
PREFIXO=/geografia
# De quantos em quantos minutos volta a ler a base (para ver alterações sem reiniciar).
RECARREGAR_MINUTOS=60
# De quantos em quantos segundos cada instância vê se os dados mudaram (alterações feitas noutra instância ou no Portal 360).
VERIFICAR_SEGUNDOS=10
# Chave da gestão (Portal 360). Gere uma longa e aleatória; o Portal 360 usa a mesma em GEOGRAFIA_CHAVE_ADMIN.
CHAVE_ADMIN=
# Monitorização no Portal 360 (Monitorização → Middleware Geografia → gerar chave). Sem elas, não monitoriza.
PORTAL_URL=
PORTAL_APP_ID=geografia-cv
MONITOR_CHAVE=
